{
  "name": "shui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp dev",
    "worker:dev": "pnpm run db:migrate && pnpm build && wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "worker:dev:staging": "pnpm build:staging && wrangler dev --config dist/server/wrangler.json",
    "build": "vp build && tsc --noEmit",
    "build:production": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.production.jsonc vp build && tsc --noEmit",
    "build:staging": "CLOUDFLARE_VITE_WRANGLER_CONFIG_PATH=wrangler.staging.jsonc vp build && tsc --noEmit",
    "deploy": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json",
    "deploy:dry": "pnpm build:production && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "deploy:staging": "pnpm build:staging && wrangler deploy --config dist/server/wrangler.json",
    "deploy:staging:dry": "pnpm build:staging && wrangler deploy --config dist/server/wrangler.json --dry-run",
    "preview": "vp preview",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "check:write": "vp check --fix",
    "test": "vp test run",
    "test:watch": "vp test",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply shui-db --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply shui-db --remote --config wrangler.production.jsonc",
    "db:migrate:staging": "wrangler d1 migrations apply shui-db-staging --remote --config wrangler.staging.jsonc",
    "auth:generate": "auth generate --config ./auth.config.ts --output ./src/db/auth-schema.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "@better-auth/core": "1.7.0-rc.5",
    "@better-auth/drizzle-adapter": "1.7.0-rc.5",
    "@better-auth/oauth-provider": "1.7.0-rc.5",
    "@cloudflare/kumo": "2.10.0",
    "@elysiajs/eden": "1.4.9",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.28",
    "@tanstack/react-start": "1.168.45",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/start-server-core": "1.169.27",
    "better-auth": "1.7.0-rc.5",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.29",
    "file-type": "21.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@cloudflare/vite-plugin": "1.52.1",
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@cloudflare/workers-types": "5.20260814.1",
    "@sinclair/typebox": "0.34.52",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.0.5",
    "auth": "1.7.0-rc.5",
    "drizzle-kit": "0.31.10",
    "jose": "6.2.8",
    "openapi-types": "12.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.123.0"
  },
  "packageManager": "pnpm@10.15.1"
}
